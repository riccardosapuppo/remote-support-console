<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The screens the detector is measured against, drawn rather than
    photographed. A screenshot of a real machine is somebody's desktop, and no
    amount of care makes that safe to publish.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportConsole.Vision\SupportConsole.Vision.csproj" />
  </ItemGroup>

</Project>
