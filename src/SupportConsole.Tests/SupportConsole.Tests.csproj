<Project Sdk="Microsoft.NET.Sdk">

  <!--
    No Windows here either. Everything that decides is in SupportConsole.Vision,
    which knows nothing about screens or capture, so the whole of it can be
    checked on any machine that has the SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>SupportConsole.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportConsole.Measure\SupportConsole.Measure.csproj" />
  </ItemGroup>

</Project>
