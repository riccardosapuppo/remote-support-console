<Window x:Class="SupportConsole.App.PracticeMachine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice machine"
        Width="720" Height="566"
        ResizeMode="NoResize"
        Background="#FF17191D"
        UseLayoutRounding="True">

    <!--
        A machine to point the console at. It is a window in the same
        application, which is the whole of the safety argument: nothing here
        reads a screen, a session, or a process that does not belong to it.

        The six states are the ones the corpus is drawn from, so what the
        console says about this window can be checked against what the
        measurement says about the drawn frame of the same name.
    -->

    <DockPanel Margin="14" Background="#FF17191D">

        <WrapPanel x:Name="Modes" DockPanel.Dock="Top" Margin="0,0,0,12">
            <WrapPanel.Resources>
                <Style TargetType="RadioButton">
                    <Setter Property="Margin" Value="0,0,14,6" />
                    <Setter Property="Foreground" Value="#FFD7DBE0" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </WrapPanel.Resources>

            <RadioButton Content="In use, light theme" Tag="InUseLight" IsChecked="True" Checked="ModeChosen" />
            <RadioButton Content="In use, dark on dark" Tag="InUseDark" Checked="ModeChosen" />
            <RadioButton Content="In use, letterboxed" Tag="InUseLetterboxed" Checked="ModeChosen" />
            <RadioButton Content="Locked, photograph" Tag="LockedPhoto" Checked="ModeChosen" />
            <RadioButton Content="Locked, dark" Tag="LockedDark" Checked="ModeChosen" />
            <RadioButton Content="Black" Tag="Black" Checked="ModeChosen" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#FF7C848F"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="Dark on dark is the one that broke the first detector: the bar is the colour of the wallpaper, so there is no edge to find. Letterboxed is the second: the bottom of the window is not the bottom of the picture." />

        <Border x:Name="Screen"
                Width="640" Height="360"
                BorderBrush="#FF3A3F47" BorderThickness="1"
                SnapsToDevicePixels="True">

            <Grid x:Name="Picture">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="BarAbove" Height="0" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="BarBelow" Height="0" />
                </Grid.RowDefinitions>

                <Rectangle Grid.Row="0" Fill="Black" />
                <Rectangle Grid.Row="2" Fill="Black" />

                <Grid Grid.Row="1" ClipToBounds="True">

                    <Rectangle x:Name="Wallpaper">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="WallpaperTop" Color="#FF6E7C93" Offset="0" />
                                <GradientStop x:Name="WallpaperBottom" Color="#FF303A4A" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Two open windows, with their text drawn from code. -->
                    <Canvas x:Name="Desktop">
                        <Border x:Name="WindowLeft" Canvas.Left="46" Canvas.Top="38"
                                Width="274" Height="158" Background="#FFEDEFF2" />
                        <Border x:Name="WindowRight" Canvas.Left="344" Canvas.Top="72"
                                Width="248" Height="176" Background="#FFF7F8FA" />
                        <Canvas x:Name="Ink" />
                    </Canvas>

                    <!-- The sign-in screen. -->
                    <Canvas x:Name="SignIn" Visibility="Collapsed">
                        <Ellipse Canvas.Left="286" Canvas.Top="86" Width="68" Height="68" Fill="#FFC8CEDA" />
                        <TextBlock Canvas.Left="272" Canvas.Top="164" Width="96"
                                   Text="R. Sapuppo" Foreground="White" FontSize="14" TextAlignment="Center" />
                        <Border x:Name="Field" Canvas.Left="263" Canvas.Top="194"
                                Width="114" Height="16" Background="#FFE9ECF1" CornerRadius="2" />
                        <TextBlock Canvas.Left="292" Canvas.Top="222" Text="Password"
                                   Foreground="#FFB9C0CC" FontSize="11" />
                        <Canvas Canvas.Left="586" Canvas.Top="330">
                            <Rectangle Width="9" Height="9" Fill="#FFCED5E0" />
                            <Rectangle Canvas.Left="15" Width="9" Height="9" Fill="#FFCED5E0" />
                            <Rectangle Canvas.Left="30" Width="9" Height="9" Fill="#FFCED5E0" />
                        </Canvas>
                    </Canvas>

                    <!-- The taskbar: icons at one end, a clock at the other. -->
                    <Border x:Name="Taskbar" Height="22" VerticalAlignment="Bottom" Background="#FFDCE0E6">
                        <Grid>
                            <StackPanel x:Name="Icons" Orientation="Horizontal"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <StackPanel x:Name="Tray" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
