<Window x:Class="SupportConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote support console"
        Width="1160" Height="752"
        Background="#FF14161A"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        What the console sees and what it decided, side by side, because the
        second is worth nothing without the first. The picture on the right is
        the 192 by 108 grid the detector actually reads, drawn one screen pixel
        per four so it can be looked at — not the original screenshot tidied up
        for presentation.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFE4E8EE" />
        <SolidColorBrush x:Key="Quiet" Color="#FF858E9B" />
        <SolidColorBrush x:Key="Faint" Color="#FF565E6A" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Quiet}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <!-- The background is on the Grid and not on the Window, because the
         picture-taking renders the content: a colour set on the window is a
         colour that is not in the file. -->
    <Grid Margin="16" Background="#FF14161A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <TextBlock DockPanel.Dock="Top" Text="WHAT TO LOOK AT" Style="{StaticResource Label}" Margin="0,0,0,8" />

            <Button DockPanel.Dock="Bottom"
                    x:Name="OpenPractice"
                    Content="Open the practice machine"
                    Height="30" Margin="0,12,0,0"
                    Click="OpenPracticeMachine" />

            <ListBox x:Name="Sources"
                     Background="#FF1B1E23"
                     BorderBrush="#FF2C3038"
                     Foreground="{StaticResource Ink}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="SourceChosen">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,5" Width="238">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas, Cascadia Mono, monospace" />
                            <TextBlock Text="{Binding Note}" Foreground="#FF7A828E" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="Heading" Style="{StaticResource Value}" FontSize="18" Margin="0,0,0,4" />
                <TextBlock x:Name="Story" Foreground="{StaticResource Quiet}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <Border DockPanel.Dock="Top" BorderBrush="#FF2C3038" BorderThickness="1" HorizontalAlignment="Left">
                <Grid Width="768" Height="432">
                    <Image x:Name="View" Width="768" Height="432" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="Overlay" Width="768" Height="432" />
                </Grid>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WHAT IT IS" Style="{StaticResource Label}" />
                    <TextBlock x:Name="State" Style="{StaticResource Value}" FontSize="22" />

                    <TextBlock Text="SOMEBODY IS LOGGED IN" Style="{StaticResource Label}" />
                    <TextBlock x:Name="LoggedIn" Style="{StaticResource Value}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="BECAUSE" Style="{StaticResource Label}" />
                    <TextBlock x:Name="Because" Style="{StaticResource Value}" TextWrapping="Wrap" FontSize="12" />

                    <TextBlock Text="WHERE THE PASSWORD WOULD GO" Style="{StaticResource Label}" />
                    <TextBlock x:Name="Click" Style="{StaticResource Value}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="DETAIL ON SCREEN" Style="{StaticResource Label}" />
                    <TextBlock x:Name="Detail" Foreground="{StaticResource Faint}" FontSize="13"
                               FontFamily="Consolas, Cascadia Mono, monospace" Margin="0,0,0,2" />
                    <TextBlock Text="measured, and not used to decide"
                               Foreground="{StaticResource Faint}" FontSize="10" Margin="0,0,0,14" />

                    <TextBlock Text="THE FIRST VERSION SAID" Style="{StaticResource Label}" />
                    <TextBlock x:Name="Before" Style="{StaticResource Value}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap"
                       Text="Reading a screen is all this does. Sending Ctrl+Alt+Del at a session and typing into it is the part that goes wrong, and it is deliberately not here: what was worth rebuilding is the decision in front of it." />
        </DockPanel>
    </Grid>
</Window>
