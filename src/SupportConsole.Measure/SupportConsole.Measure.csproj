<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the corpus through both versions of the detector and prints the
    difference. Every number quoted in the README comes out of here, and CI
    runs it so a number that stops being true stops the build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>SupportConsole.Measure</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupportConsole.Frames\SupportConsole.Frames.csproj" />
  </ItemGroup>

</Project>
